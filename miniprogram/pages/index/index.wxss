.page {
  height: 100vh;
  padding: 0 16px;
  box-sizing: border-box;
}

/* ---- 身份 ---- */

.profile {
  display: flex;
  align-items: center;
  padding: 20px 4px 16px;
}

.avatar {
  width: 60px;
  height: 60px;
  border-radius: var(--r-pill);
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji { font-size: 30px; }

.who {
  flex: 1;
  min-width: 0;
  padding-left: 14px;
}

.name {
  display: block;
  font-size: 19px;
  font-weight: 700;
  color: var(--ink);
}

.id {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--ink-soft);
}

/* ---- 统计 ---- */

.stats {
  display: flex;
  padding: 16px 4px;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 22px;
  font-weight: 800;
  color: var(--primary);
}

.stat-label {
  margin-top: 3px;
  font-size: 11px;
  color: var(--ink-soft);
}

.shelf-note {
  padding: 10px 6px 2px;
}

.shelf-note-txt {
  font-size: 11px;
  color: var(--ink-faint);
}

/* ---- 菜单 ---- */

.menu {
  margin-top: 12px;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.item {
  display: flex;
  align-items: center;
  height: 50px;              /* ≥ 44px 热区 */
  padding: 0 14px;
  border-bottom: 1px solid var(--line);
}

.item-last { border-bottom: none; }

.item-press { background: #FAF7EF; }

.item-icon {
  font-size: 17px;
  width: 28px;
}

.item-label {
  flex: 1;
  font-size: 15px;
  color: var(--ink);
}

.item-chevron {
  font-size: 20px;
  color: #D6CDBB;
}

.copyright {
  display: block;
  padding: 18px 8px 30px;
  text-align: center;
  font-size: 11px;
  line-height: 1.6;
  color: var(--ink-faint);
}
