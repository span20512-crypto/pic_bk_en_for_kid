<view class="wrap">
  <!-- 用户信息 -->
  <view class="user card-base">
    <view class="avatar">🧒</view>
    <view class="flex-col flex-1">
      <text class="nick">{{session.nickname}}</text>
      <text class="uid">ID: {{session.userId}}</text>
    </view>
  </view>

  <!-- 阅读统计 -->
  <view class="stats card-base">
    <view class="stat">
      <text class="stat-num">{{stats.booksDone}}</text>
      <text class="stat-label">已读绘本</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.pagesRead}}</text>
      <text class="stat-label">累计页数</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.streak}}</text>
      <text class="stat-label">连续天数</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.words}}</text>
      <text class="stat-label">生词数</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu card-base">
    <view
      wx:for="{{menu}}"
      wx:key="label"
      class="menu-item"
      hover-class="press-dim"
      bindtap="onMenuTap"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-label flex-1">{{item.label}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="about">
    <text>英语绘本馆 · MVP</text>
    <text>绘本选题来自小红书 @快乐学英语008，台词与画面均为原创改写</text>
    <text>视频占位素材：Mixkit（免版权）· 语音：微软 en-US-AnaNeural</text>
  </view>
</view>
