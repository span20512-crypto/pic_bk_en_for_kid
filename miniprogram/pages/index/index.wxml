<scroll-view class="page" scroll-y>
  <!-- 身份 -->
  <view class="profile">
    <view class="avatar"><text class="avatar-emoji">🙋</text></view>
    <view class="who">
      <text class="name">{{nickName}}</text>
      <text class="id">{{isGuest ? '游客阅读中 · 数据存在本机' : idText}}</text>
    </view>
  </view>

  <!-- 阅读统计（PRD §3.8） -->
  <view class="stats">
    <view class="stat">
      <text class="stat-num">{{stats.booksDone}}</text>
      <text class="stat-label">读完绘本</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.pagesRead}}</text>
      <text class="stat-label">累计页数</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.streakDays}}</text>
      <text class="stat-label">连续天数</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.wordCount}}</text>
      <text class="stat-label">生词本</text>
    </view>
  </view>

  <view class="shelf-note">
    <text class="shelf-note-txt">绘本馆已上线 {{releasedCount}} / {{totalCount}} 本，其余正在制作中</text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu">
    <view
      wx:for="{{menu}}"
      wx:key="key"
      class="item{{item.last ? ' item-last' : ''}}"
      hover-class="item-press"
      hover-stay-time="80"
      data-key="{{item.key}}"
      bindtap="onTapMenu"
    >
      <text class="item-icon">{{item.icon}}</text>
      <text class="item-label">{{item.label}}</text>
      <text class="item-chevron">›</text>
    </view>
  </view>

  <!-- 版权与来源（PRD §2.2 上线前置） -->
  <view class="menu">
    <view class="item item-last" hover-class="item-press" hover-stay-time="80" bindtap="onTapAbout">
      <text class="item-icon">📄</text>
      <text class="item-label">素材来源与授权状态</text>
      <text class="item-chevron">›</text>
    </view>
  </view>

  <text class="copyright">台词与画面均为原创改写，原视频不搬运、不嵌入</text>
</scroll-view>
