/* ==================== 列表 ==================== */

.shelf {
  height: 100vh;
  padding: 0 16px;
  box-sizing: border-box;
}

.hero {
  padding: 14px 4px 10px;
}

.hero-title {
  display: block;
  font-size: 22px;
  font-weight: 800;
  color: var(--ink);
}

.hero-sub {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: var(--ink-soft);
}

.group {
  margin-bottom: 6px;
}

/*
 * 系列标题吸顶（PRD §3.1）。背景必须是不透明的奶油白 —— sticky 元素下面
 * 会有卡片滑过，半透明背景会把卡片透出来，读起来像重影。
 */
.group-head {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  padding: 10px 4px 8px;
  background: var(--bg);
}

.group-emoji {
  font-size: 20px;
  line-height: 1.2;
  margin-right: 8px;
}

.group-text {
  flex: 1;
  min-width: 0;
}

.group-title {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: var(--ink);
}

.group-sub {
  display: block;
  font-size: 11px;
  color: var(--ink-faint);
}

.group-count {
  flex-shrink: 0;
  font-size: 12px;
  color: var(--ink-soft);
}

.group-count-done { color: var(--level1); }

.foot {
  padding: 12px 0 28px;
  text-align: center;
}

.foot-txt {
  font-size: 12px;
  color: var(--ink-faint);
}

/* ==================== 阅读器 ==================== */

.reader {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 8px 0 28px;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 0 12px;
  box-sizing: border-box;
}

.back {
  width: 84px;
  height: 44px;          /* 44px 热区（PRD §6 无障碍） */
  display: flex;
  align-items: center;
}

.back-ghost { visibility: hidden; }  /* 右侧等宽占位，让标题真正居中 */

.back-press { opacity: 0.5; }

.back-txt {
  font-size: 14px;
  font-weight: 600;
  color: var(--primary);
}

.topbar-title {
  flex: 1;
  text-align: center;
  font-size: 15px;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.counter {
  margin: 2px 0 8px;
  font-size: 12px;
  color: var(--ink-soft);
}

.dots {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.dot {
  width: 6px;
  height: 6px;
  margin: 0 3px;
  border-radius: var(--r-pill);
  background: #E3DCCC;
  transition: width 0.25s ease, background 0.25s ease;
}

.dot-passed { background: var(--level1); }

.dot-now {
  width: 18px;
  background: var(--primary);
}

.deck {
  width: 100%;
  height: 262px;   /* 画面 250 + 上下呼吸 */
}

.slide {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* The End 庆祝页 */
.curtain {
  width: 320px;
  height: 250px;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  box-shadow: var(--shadow-lift);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.curtain-emoji {
  font-size: 58px;
  line-height: 1.2;
  animation: bk-bounce 1.8s ease-in-out infinite;
}

.curtain-title {
  margin-top: 10px;
  font-size: 22px;
  font-weight: 800;
  color: #92400E;
}

.curtain-sub {
  margin-top: 6px;
  font-size: 14px;
  color: #B45309;
}

.hint {
  margin-top: 10px;
  font-size: 11px;
  color: var(--ink-faint);
}

/* ---- 操作按钮 ---- */

.actions {
  display: flex;
  align-items: center;
  margin-top: 14px;
}

.btn {
  height: 46px;         /* ≥ 44px 热区 */
  padding: 0 28px;
  margin: 0 6px;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.btn-press { transform: scale(0.95); }

.btn-play {
  margin-top: 14px;
  padding: 0 40px;
  background: var(--primary);
  box-shadow: 0 4px 14px rgba(52, 211, 153, 0.35);
}

/* 播放中转强调橙（PRD §3.4） */
.btn-playing {
  background: var(--accent);
  box-shadow: 0 4px 14px rgba(255, 140, 66, 0.35);
}

.btn-primary {
  background: var(--primary);
  box-shadow: 0 4px 14px rgba(52, 211, 153, 0.35);
}

.btn-ghost {
  background: var(--surface);
  border: 1px solid var(--line);
}

.btn-txt {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.btn-txt-dark { color: var(--ink-soft); }

.pager {
  display: flex;
  align-items: center;
  width: 320px;
  margin-top: 12px;
}

.page-btn {
  flex: 1;
  height: 44px;
  margin: 0 5px;
  border-radius: var(--r-pill);
  background: var(--surface);
  border: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-btn-off { opacity: 0.4; }

.page-txt {
  font-size: 14px;
  color: var(--ink-soft);
}
