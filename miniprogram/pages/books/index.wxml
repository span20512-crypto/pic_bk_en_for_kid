<!-- 绘本馆：列表与阅读器共用一页，mode 决定渲染哪一支 -->

<!-- ==================== 列表 ==================== -->
<scroll-view
  wx:if="{{mode === 'list'}}"
  class="shelf"
  scroll-y
  enable-back-to-top
  scroll-top="{{scrollTop}}"
  bindscroll="onListScroll"
>
  <view class="hero">
    <text class="hero-title">英语绘本馆</text>
    <text class="hero-sub">看动画 · 听旁白 · 读字幕</text>
  </view>

  <view wx:for="{{groups}}" wx:key="series" wx:for-item="group" class="group">
    <!-- 系列标题吸顶，滚动中始终看得见当前在哪个系列（PRD §3.1） -->
    <view class="group-head">
      <text class="group-emoji">{{group.emoji}}</text>
      <view class="group-text">
        <text class="group-title">{{group.title}}</text>
        <text class="group-sub">{{group.subtitle}}</text>
      </view>
      <text class="group-count{{group.allRead ? ' group-count-done' : ''}}">{{group.readCount}}/{{group.total}} 本</text>
    </view>

    <book-card
      wx:for="{{group.books}}"
      wx:key="id"
      book="{{item}}"
      bind:open="onOpenBook"
    />
  </view>

  <view class="foot">
    <text class="foot-txt">更多绘本正在录制中 🎬</text>
  </view>
</scroll-view>

<!-- ==================== 阅读器 ==================== -->
<view wx:else class="reader fade-in">
  <view class="topbar">
    <view class="back" hover-class="back-press" hover-stay-time="80" bindtap="exitReader">
      <text class="back-txt">← 绘本馆</text>
    </view>
    <text class="topbar-title">{{book.titleCn}}</text>
    <view class="back back-ghost"></view>
  </view>

  <text class="counter">{{atEnd ? '读完啦！' : '第 ' + (pageIndex + 1) + ' / ' + book.total + ' 页'}}</text>

  <view class="dots">
    <view
      wx:for="{{dots}}"
      wx:key="index"
      class="dot{{item.wide ? ' dot-now' : ''}}{{item.passed ? ' dot-passed' : ''}}"
    ></view>
  </view>

  <swiper class="deck" current="{{pageIndex}}" bindchange="onSwiperChange">
    <swiper-item wx:for="{{pages}}" wx:key="index" wx:for-item="p" wx:for-index="pi">
      <view class="slide">
        <story-stage
          page="{{p}}"
          active="{{pi === pageIndex}}"
          video-src="{{videoSrc}}"
          loading="{{loading}}"
          percent="{{percent}}"
          playing="{{playing}}"
          si="{{si}}"
          wi="{{wi}}"
          bind:tapword="onTapWord"
          bind:videoerror="onVideoError"
        />
      </view>
    </swiper-item>

    <!-- The End 庆祝页 -->
    <swiper-item>
      <view class="slide">
        <view class="curtain">
          <text class="curtain-emoji">🎉</text>
          <text class="curtain-title">The End</text>
          <text class="curtain-sub">读完了《{{book.titleCn}}》，太棒啦！</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <gloss-bar
    gloss="{{gloss}}"
    just-saved="{{justSaved}}"
    bind:play="onPlayGloss"
    bind:close="onCloseGloss"
  />

  <text wx:if="{{!atEnd && !gloss}}" class="hint">点「播放绘本」听旁白 · 点字幕里带下划线的词查释义</text>

  <!-- 操作区 -->
  <view wx:if="{{atEnd}}" class="actions">
    <view class="btn btn-primary" hover-class="btn-press" hover-stay-time="80" bindtap="onReadAgain">
      <text class="btn-txt">🔄 再读一遍</text>
    </view>
    <view class="btn btn-ghost" hover-class="btn-press" hover-stay-time="80" bindtap="exitReader">
      <text class="btn-txt btn-txt-dark">返回绘本馆</text>
    </view>
  </view>

  <block wx:else>
    <view
      class="btn btn-play{{playing ? ' btn-playing' : ''}}"
      hover-class="btn-press"
      hover-stay-time="80"
      bindtap="onTogglePlay"
    >
      <text class="btn-txt">{{playing ? '⏸ 播放中…' : '▶️ 播放绘本'}}</text>
    </view>

    <view class="pager">
      <view
        class="page-btn{{pageIndex === 0 ? ' page-btn-off' : ''}}"
        hover-class="btn-press"
        hover-stay-time="80"
        bindtap="onPrev"
      >
        <text class="page-txt">← 上一页</text>
      </view>
      <view class="page-btn" hover-class="btn-press" hover-stay-time="80" bindtap="onNext">
        <text class="page-txt">下一页 →</text>
      </view>
    </view>
  </block>
</view>
