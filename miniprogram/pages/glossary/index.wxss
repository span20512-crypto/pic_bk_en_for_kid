.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 16px;
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: flex-end;
  padding: 14px 4px 10px;
}

.head-text {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: 22px;
  font-weight: 800;
  color: var(--ink);
}

.sub {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: var(--ink-soft);
}

.review {
  flex-shrink: 0;
  height: 36px;
  padding: 0 14px;
  border-radius: var(--r-pill);
  background: var(--primary);
  display: flex;
  align-items: center;
  box-shadow: 0 3px 10px rgba(52, 211, 153, 0.3);
}

.review-on {
  background: var(--accent);
  box-shadow: 0 3px 10px rgba(255, 140, 66, 0.3);
}

.review-press { transform: scale(0.95); }

.review-txt {
  font-size: 13px;
  font-weight: 600;
  color: #FFFFFF;
}

/* ---- 筛选条 ---- */

.chips {
  white-space: nowrap;
  padding: 4px 0 10px;
}

.chip {
  display: inline-block;
  padding: 6px 14px;
  margin-right: 8px;
  border-radius: var(--r-pill);
  background: var(--surface);
  border: 1px solid var(--line);
}

.chip-on {
  background: var(--primary-soft);
  border-color: var(--primary);
}

.chip-txt {
  font-size: 12px;
  color: var(--ink-soft);
}

.chip-on .chip-txt {
  color: #0F766E;
  font-weight: 600;
}

/* ---- 词条 ---- */

.list {
  flex: 1;
  min-height: 0;
}

.card {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  margin-bottom: 10px;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-press { transform: scale(0.98); }

/* 复习到的那条抬起来，眼睛跟得上声音 */
.card-live {
  box-shadow: 0 0 0 2px var(--accent), var(--shadow-lift);
}

.speaker {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: var(--r-pill);
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.speaker-icon { font-size: 19px; }

.body {
  flex: 1;
  min-width: 0;
  padding: 0 12px;
}

.word {
  display: block;
  font-size: 17px;
  font-weight: 700;
  color: var(--ink);
}

.cn {
  display: block;
  margin-top: 2px;
  font-size: 13px;
  color: var(--ink-soft);
}

.from {
  flex-shrink: 0;
  max-width: 96px;
  font-size: 11px;
  color: var(--ink-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tip {
  display: block;
  padding: 6px 0 28px;
  text-align: center;
  font-size: 11px;
  color: var(--ink-faint);
}

/* ---- 空态 ---- */

.blank {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 60px;
}

.blank-emoji {
  font-size: 56px;
  line-height: 1.2;
  animation: bk-float 3s ease-in-out infinite;
}

.blank-title {
  margin-top: 12px;
  font-size: 17px;
  font-weight: 700;
  color: var(--ink);
}

.blank-sub {
  margin-top: 6px;
  text-align: center;
  font-size: 13px;
  line-height: 1.7;
  color: var(--ink-soft);
}

.blank-btn {
  margin-top: 20px;
  height: 44px;
  padding: 0 26px;
  border-radius: var(--r-pill);
  background: var(--primary);
  display: flex;
  align-items: center;
  box-shadow: 0 4px 14px rgba(52, 211, 153, 0.32);
}

.blank-btn-txt {
  font-size: 15px;
  font-weight: 600;
  color: #FFFFFF;
}
