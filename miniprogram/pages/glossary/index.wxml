<view class="page">
  <view class="head">
    <view class="head-text">
      <text class="title">生词本</text>
      <text class="sub">阅读时点开过的词都在这儿</text>
    </view>
    <view
      wx:if="{{!empty}}"
      class="review{{reviewing ? ' review-on' : ''}}"
      hover-class="review-press"
      hover-stay-time="80"
      bindtap="onToggleReview"
    >
      <text class="review-txt">{{reviewing ? '⏸ 复习中' : '🔊 一键复习'}}</text>
    </view>
  </view>

  <!-- 空态：直接给一条去读绘本的路，而不是干晾着 -->
  <view wx:if="{{empty}}" class="blank">
    <text class="blank-emoji">🔤</text>
    <text class="blank-title">还没有生词</text>
    <text class="blank-sub">读绘本时，点一点字幕里带下划线的词，
就会自动收进这里</text>
    <view class="blank-btn" hover-class="review-press" hover-stay-time="80" bindtap="onGoRead">
      <text class="blank-btn-txt">去绘本馆看看</text>
    </view>
  </view>

  <block wx:else>
    <scroll-view class="chips" scroll-x enable-flex>
      <view
        wx:for="{{filters}}"
        wx:key="id"
        class="chip{{item.id === activeFilter ? ' chip-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickFilter"
      >
        <text class="chip-txt">{{item.label}} · {{item.count}}</text>
      </view>
    </scroll-view>

    <scroll-view class="list" scroll-y enable-back-to-top>
      <view
        wx:for="{{words}}"
        wx:key="word"
        class="card{{index === reviewIndex ? ' card-live' : ''}}"
        hover-class="card-press"
        hover-stay-time="80"
        data-word="{{item.word}}"
        data-book="{{item.bookId}}"
        bindtap="onTapWord"
        bindlongpress="onLongPress"
      >
        <view class="speaker"><text class="speaker-icon">🔊</text></view>
        <view class="body">
          <text class="word">{{item.word}}</text>
          <text class="cn">{{item.cn}}</text>
        </view>
        <text class="from">《{{item.bookTitle}}》</text>
      </view>

      <text class="tip">长按词条可移出生词本</text>
    </scroll-view>
  </block>
</view>
