<view class="wrap">
  <view wx:if="{{!entries.length && activeFilter === 'all'}}" class="empty">
    <text class="empty-emoji">🔤</text>
    <text class="empty-title">生词本还是空的</text>
    <text class="empty-sub">去绘本里点一点带下划线的单词吧</text>
  </view>

  <block wx:else>
    <scroll-view scroll-x class="filter-bar" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{filters}}"
        wx:key="id"
        class="chip {{activeFilter === item.id ? 'chip-on' : ''}}"
        hover-class="press-dim"
        bindtap="onFilterTap"
        data-id="{{item.id}}"
      >{{item.label}}</view>
    </scroll-view>

    <view
      class="review-btn {{reviewing ? 'review-on' : ''}}"
      hover-class="press"
      bindtap="toggleReview"
    >{{reviewing ? '⏹ 停止复习' : '🔁 一键复习（顺序播放发音）'}}</view>

    <view
      wx:for="{{entries}}"
      wx:key="index"
      class="entry card-base {{reviewIdx === index ? 'entry-hot' : ''}}"
    >
      <view class="flex-col flex-1">
        <text class="e-word">{{item.word}}</text>
        <text class="e-cn">{{item.cn}}</text>
        <text class="e-src">出自 {{item.bookTitle}}</text>
      </view>
      <view class="e-play" hover-class="press-dim" bindtap="onPlayTap" data-idx="{{index}}">🔊</view>
    </view>
  </block>
</view>
