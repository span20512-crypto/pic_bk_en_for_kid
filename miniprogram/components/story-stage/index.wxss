/* 画面舞台。尺寸 320×250 定死（PRD §3.3），字幕字号才能按物理像素设计 */

.stage {
  position: relative;
  width: 320px;
  height: 250px;
  border-radius: var(--r-lg, 22px);
  overflow: hidden;
  background: #0F172A;
  box-shadow: var(--shadow-lift, 0 6px 20px rgba(120, 100, 60, 0.14));
}

.scene,
.film {
  position: absolute;
  top: 0;
  left: 0;
  width: 320px;
  height: 250px;
}

/* 主体 Emoji：居中偏上，给底部字幕条留出空间 */
.hero {
  position: absolute;
  top: 56px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 68px;
  line-height: 1.2;
  text-shadow: 0 3px 10px rgba(0, 0, 0, 0.22);
  animation: bk-float 2.8s ease-in-out infinite;
}

.decor {
  position: absolute;
  top: 16px;
  font-size: 30px;
  line-height: 1.2;
  opacity: 0.95;
}

.decor-l {
  left: 22px;
  animation: bk-float 3.4s ease-in-out infinite;
}

.decor-r {
  right: 22px;
  animation: bk-bounce 2.2s ease-in-out infinite;
}

.badge {
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  padding: 4px 12px;
  border-radius: var(--r-pill, 999px);
  background: rgba(15, 23, 42, 0.55);
}

.badge-txt {
  font-size: 12px;
  color: #FFFFFF;
}
