.bar {
  display: flex;
  align-items: center;
  width: 320px;
  padding: 10px 12px;
  border-radius: var(--r-lg, 22px);
  background: var(--surface, #FFFFFF);
  box-shadow: var(--shadow-card, 0 2px 10px rgba(120, 100, 60, 0.08));
}

/* 发音按钮：44×44 热区（PRD §6 无障碍） */
.speak {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: var(--r-pill, 999px);
  background: var(--primary-soft, #D1FAE5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.speak-press { transform: scale(0.9); }

.speak-icon { font-size: 20px; }

.body {
  flex: 1;
  min-width: 0;
  padding: 0 12px;
}

.word {
  display: block;
  font-size: 17px;
  font-weight: 700;
  color: var(--ink, #1F2937);
}

.cn {
  display: block;
  margin-top: 2px;
  font-size: 13px;
  color: var(--ink-soft, #6B7280);
}

.saved {
  flex-shrink: 0;
  padding: 3px 8px;
  margin-right: 6px;
  border-radius: var(--r-pill, 999px);
  background: var(--primary-soft, #D1FAE5);
}

.saved-txt {
  font-size: 10px;
  color: #0F766E;
}

.close {
  flex-shrink: 0;
  width: 32px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-press { opacity: 0.5; }

.close-icon {
  font-size: 15px;
  color: var(--ink-faint, #9CA3AF);
}
