/*
 * 全局主题与基础排版（PRD §1.2 主题色系）
 *
 * 这里只放两类东西：设计令牌（CSS 变量）和少量真正全局的东西（页面底色、
 * 关键帧）。**不做原子类表** —— 微信官方框架推荐的组织方式是自定义组件 +
 * 组件内样式隔离，每个组件的样式跟着组件文件走；再叠一层全局原子类，会让
 * 组件的样式隔离形同虚设，也让「改这个卡片」变成「先找哪些页面复用了这个类」。
 *
 * 单位一律用 px 不用 rpx：绘本页的视频框、字幕字号都是按设计稿定死的物理尺寸，
 * rpx 会随屏宽等比放大，大屏上字幕会大到压住画面。需要跟随屏宽的地方（列表宽度）
 * 用百分比与 flex 解决。
 */

page {
  /* ── 色板 ── */
  --bg: #FFFDF7;            /* 奶油白 */
  --surface: #FFFFFF;
  --primary: #34D399;       /* 森林绿 */
  --primary-soft: #D1FAE5;
  --accent: #FF8C42;        /* 活力橙 */
  --level1: #22C55E;
  --level1-bg: #ECFDF5;
  --level2: #FBBF24;
  --level2-bg: #FEF3C7;
  --ink: #1F2937;
  --ink-soft: #6B7280;
  --ink-faint: #9CA3AF;
  --line: #EFE9DC;
  --gloss: #7DD3FC;         /* 字幕里的生词色 */

  /* ── 圆角与阴影：儿童向，圆角给足 ── */
  --r-sm: 10px;
  --r-md: 16px;
  --r-lg: 22px;
  --r-pill: 999px;
  --shadow-card: 0 2px 10px rgba(120, 100, 60, 0.08);
  --shadow-lift: 0 6px 20px rgba(120, 100, 60, 0.14);

  min-height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-size: 16px;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 全局关键帧：WXSS 不允许在 inline style 里写 @keyframes，统一放这儿 */

@keyframes bk-fade-in {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 朗读中字幕的呼吸脉冲（PRD §3.5 opacity 0.7 ↔ 1） */
@keyframes bk-breathe {
  from { opacity: 0.7; }
  to   { opacity: 1; }
}

/* 场景 Emoji 的漂浮与弹跳 */
@keyframes bk-float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25%      { transform: translateY(-6px) rotate(2deg); }
  75%      { transform: translateY(3px) rotate(-2deg); }
}

@keyframes bk-bounce {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}

.fade-in { animation: bk-fade-in 0.25s ease; }
