@import "styles/utils.wxss";

page {
  background: #FFFDF7;
  color: #1F2937;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 15px;
}

view, text, button {
  box-sizing: border-box;
}

/* 去掉 button 默认样式 */
button {
  padding: 0;
  margin: 0;
  background: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
}
button::after {
  border: none;
}
